# Copy to .env (chmod 600). Never commit .env.
BOT_TOKEN=
# Where reports go: an admin group (negative ID from the web.telegram.org/a/#-... address bar; bot
# must be a member) or one admin (writes /start to the bot, it answers with the ID)
REPORT_CHAT_ID=
# Group ID(s), comma-separated; empty = every group the bot is added to
ALLOWED_CHAT_IDS=
# 1 = test mode: delete only when someone taps "Löschen" under the report. 0 = delete on its own.
DRY_RUN=1
STRIKES_TO_BAN=2
# Optional stage 2 (Claude Haiku for unclear messages). Empty = rules only.
ANTHROPIC_API_KEY=
# Join captcha: minutes a new member has to tap "Ich bin kein Bot" (muted until then). 0 = off.
CAPTCHA_MINUTES=0
